#!/hint/bash

pkgname=av1an-git
pkgver=r2488.0fa433c0
pkgrel=2
pkgdesc='A cross-platform all-in-one tool for streamlining AV1 encoding'
arch=('x86_64')
url='https://github.com/master-of-zen/Av1an'
license=('GPL3')
makedepends=('git' 'rust' 'nasm' 'clang')
depends=('ffmpeg' 'aom' 'vapoursynth')
optdepends=(
    'svt-av1: SVT-AV1 encoder support'
    'rav1e: rAV1e encoder support'
    'x265: HEVC encoder support'
    'libvpx: VPX encoder support'
    'vmaf: VMAF calculation support'
    'mkvtoolnix-cli: mkvmerge support'
    'ffms2: FFMS2 chunk detection support'
    'vapoursynth-plugin-lsmashsource: L-SMASH chunk detection support'
)
provides=('av1an')
source=("git+https://github.com/master-of-zen/Av1an.git")
sha256sums=('SKIP')
options=('!debug')

pkgver() {
    cd "Av1an"
    printf "r%s.%s" "$(git rev-list --count HEAD)" "$(git rev-parse --short HEAD)"
}

prepare() {
    cd "Av1an"
    export CARGO_TARGET_X86_64_UNKNOWN_LINUX_GNU_LINKER=clang
    cargo fetch --target "${arch}-unknown-linux-gnu"
}

build() {
    cd "Av1an"
    # Force the build environment to use LLVM/Clang
    export CC=clang CXX=clang++
    export CARGO_TARGET_X86_64_UNKNOWN_LINUX_GNU_LINKER=clang
    export CFLAGS+=" -flto=thin" CXXFLAGS+=" -flto=thin"
    # local CFLAGS+=" -ffat-lto-objects"
    RUSTUP_TOOLCHAIN=stable \
        cargo build --target "${arch}-unknown-linux-gnu" --release

    strip "target/${arch}-unknown-linux-gnu/release/av1an"
}

package() {
    cd "Av1an"
    install -Dm 755 target/${arch}-unknown-linux-gnu/release/av1an -t "${pkgdir}/usr/bin"
}

